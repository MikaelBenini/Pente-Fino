# Copie para .env (cp .env.example .env) e ajuste se precisar.
# Os valores abaixo servem só para desenvolvimento. Nunca suba o .env para o Git.
# Em produção, o .env é criado direto na VPS, com senhas longas e diferentes destas (Etapa 10).

NODE_ENV=development
TZ=UTC

# --- URLs públicas ---------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- API (apps/api) --------------------------------------------------------
API_PORT=3001

# --- PostgreSQL (infra/docker-compose.dev.yml) -----------------------------
POSTGRES_PORT=5432
# Superusuário do container: só para manutenção, nunca usado pelo sistema.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

DB_NAME=pente_fino
# Dono das tabelas: roda as migrações.
DB_OWNER_USER=pente_fino_owner
DB_OWNER_PASSWORD=owner_dev
# Usuário da aplicação: sem superusuário, sujeito ao RLS.
DB_APP_USER=pente_fino_app
DB_APP_PASSWORD=app_dev

# Conexões montadas a partir dos valores acima.
DATABASE_URL=postgresql://pente_fino_app:app_dev@localhost:5432/pente_fino
DATABASE_MIGRATION_URL=postgresql://pente_fino_owner:owner_dev@localhost:5432/pente_fino
# Banco descartável que o Prisma usa para conferir migrações (só desenvolvimento).
SHADOW_DATABASE_URL=postgresql://pente_fino_owner:owner_dev@localhost:5432/pente_fino_shadow

# --- Redis (filas BullMQ e cache) ------------------------------------------
REDIS_PORT=6379
# Banco 0 para o sistema; a Evolution API usa o banco 6.
REDIS_URL=redis://localhost:6379/0

# --- Autenticação -----------------------------------------------------------
# Em produção: valor aleatório longo (openssl rand -base64 48). A API não sobe com o de exemplo.
JWT_ACCESS_SECRET=troque-em-producao-acesso
# Validade do token de acesso (JWT) e da sessão (token de renovação): 45s, 15m, 12h, 30d.
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Tentativas por minuto em login, convite e senha (por IP + e-mail).
LIMITE_AUTH_POR_MINUTO=10
# Requisições por minuto por IP em qualquer rota (o teste de carga usa um número alto).
LIMITE_POR_MINUTO=300

# --- API: operação -----------------------------------------------------------
# Documentação OpenAPI em /docs (padrão: ligada fora de produção; em homologação, true).
API_DOCS=true
# true atrás do Caddy (produção), para o limite de tentativas ver o IP real.
TRUST_PROXY=false
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# --- WhatsApp: Evolution API -----------------------------------------------
EVOLUTION_PORT=8080
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution API (painel em http://localhost:8080/manager).
EVOLUTION_API_KEY=troque-esta-chave-dev
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution_dev

# --- E-mail (em desenvolvimento tudo cai no Mailpit: http://localhost:8025) -
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAILPIT_UI_PORT=8025
EMAIL_FROM="Pente Fino <nao-responda@pentefino.local>"
