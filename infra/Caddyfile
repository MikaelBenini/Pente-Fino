# HTTPS automático (Let's Encrypt) para os endereços do Pente Fino. DOMINIO e companhia vêm do
# .env pelo docker-compose.prod.yml. Os registros A de @, www, app, api e wa apontam para a VPS.
{
	email {$ACME_EMAIL}
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip
}

# Site, painel, app do barbeiro, TV e link público de agendamento, no domínio principal.
{$DOMINIO} {
	import seguranca
	reverse_proxy web:3000
}

# API: o painel fala com ela por dentro (web → api); aqui ficam os webhooks (Asaas).
api.{$DOMINIO} {
	import seguranca
	# O webhook do WhatsApp só vem da Evolution, por dentro (http://api:3001). Fechado para fora:
	# a assinatura é fixa por instância e não cobre o corpo (segurança W2).
	@webhook_whatsapp path /webhooks/whatsapp /webhooks/whatsapp/*
	respond @webhook_whatsapp 404
	reverse_proxy api:3001
}

# Painel da Evolution API, só com usuário e senha (WA_SENHA_HASH gerado pelo instalar.sh).
wa.{$DOMINIO} {
	import seguranca
	basic_auth {
		{$WA_USUARIO} {$WA_SENHA_HASH}
	}
	reverse_proxy evolution:8080
}

# Monitoramento (Uptime Kuma, com login próprio).
status.{$DOMINIO} {
	import seguranca
	reverse_proxy status:3001
}

# www e o antigo app. levam ao domínio principal, mantendo o caminho.
www.{$DOMINIO}, app.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
