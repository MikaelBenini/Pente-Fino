{
  "name": "pente-fino",
  "private": true,
  "description": "Sistema de gestão para barbearias: painel web, app do barbeiro e bot de WhatsApp sem IA.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm infra:up && turbo run dev",
    "dev:apps": "turbo run dev",
    "infra:up": "node scripts/verificar-env.mjs && docker compose --env-file .env -f infra/docker-compose.dev.yml up -d --wait --wait-timeout 300",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.dev.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.dev.yml down --volumes",
    "infra:plataforma": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d --wait postgres && docker compose --env-file .env -f infra/docker-compose.dev.yml exec -T postgres sh /docker-entrypoint-initdb.d/02-plataforma.sh",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.dev.yml logs -f",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.dev.yml ps",
    "infra:verificar": "bash infra/verificar-ambiente.sh",
    "whatsapp:qr": "node scripts/whatsapp-qr.mjs",
    "db:migrate": "pnpm --filter @pente-fino/db db:migrate",
    "db:deploy": "pnpm --filter @pente-fino/db db:deploy",
    "db:seed": "pnpm --filter @pente-fino/db db:seed",
    "admin:criar": "pnpm --filter @pente-fino/db admin:criar",
    "db:studio": "pnpm --filter @pente-fino/db db:studio",
    "test:db": "pnpm --filter @pente-fino/db test:db",
    "test:e2e": "pnpm --filter @pente-fino/api test:e2e",
    "carga": "node scripts/carga.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
