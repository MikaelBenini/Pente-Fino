// Schema do MVP. Fonte: docs/documentacao-do-produto.md, seção 5.
//
// Convenções:
// - Tabelas e colunas em snake_case no banco; modelos e campos em camelCase no código.
// - Toda tabela de negócio tem conta_id, preenchido pelo banco com conta_atual()
//   (lê app.conta_id da sessão). A API nunca envia conta_id. O RLS está na migração "rls".
// - Dinheiro em centavos (Int). Percentual em pontos-base (Int): 10000 = 100%.
// - Instantes em timestamptz (UTC). Datas sem hora (vigência, competência) em date.
// - Relações para "pais donos" usam Cascade; referências usam NoAction, que só é
//   conferida no fim do comando e deixa a exclusão de uma conta inteira funcionar.
// - Restrições que o Prisma não expressa (exclusão de horário, CHECKs, índices com
//   NULLS NOT DISTINCT) estão nas migrações SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Plano {
  basico
  pro
  premium

  @@map("plano")
}

enum CicloCobranca {
  mensal
  anual

  @@map("ciclo_cobranca")
}

enum StatusConta {
  teste
  ativa
  suspensa
  cancelada

  @@map("status_conta")
}

enum Papel {
  dono
  gestor
  recepcao
  barbeiro

  @@map("papel")
}

enum TipoItemComissao {
  servico
  produto

  @@map("tipo_item_comissao")
}

enum TipoItemComanda {
  servico
  produto
  nao_operacional

  @@map("tipo_item_comanda")
}

enum StatusAgendamento {
  agendado
  confirmado
  atendido
  cancelado
  falta

  @@map("status_agendamento")
}

enum OrigemAgendamento {
  balcao
  bot
  app
  link

  @@map("origem_agendamento")
}

enum StatusComanda {
  prevista
  em_atendimento
  confirmada
  pendente
  fechada
  cancelada
  reaberta

  @@map("status_comanda")
}

enum FormaPagamento {
  dinheiro
  pix
  debito
  credito
  clube

  @@map("forma_pagamento")
}

enum TipoItemClube {
  assinatura
  combo
  convenio

  @@map("tipo_item_clube")
}

enum StatusAdesao {
  ativa
  vencida
  cancelada

  @@map("status_adesao")
}

enum StatusEspera {
  aguardando
  oferecido
  atendido
  cancelado

  @@map("status_espera")
}

enum OrigemEspera {
  balcao
  bot
  site
  antecipar

  @@map("origem_espera")
}

enum GrupoDespesa {
  fixa
  variavel
  manutencao
  investimento
  retirada_dono
  cartao_resgate

  @@map("grupo_despesa")
}

enum TipoMeta {
  faturamento
  servico

  @@map("tipo_meta")
}

enum StatusBotConexao {
  desconectado
  aguardando_qr
  conectado

  @@map("status_bot_conexao")
}

enum StatusMenuBot {
  rascunho
  publicado
  arquivado

  @@map("status_menu_bot")
}

enum TipoToken {
  renovacao
  redefinir_senha
  convite
  /// Link do e-mail de boas-vindas do cadastro pelo site (Etapa 15.4).
  confirmar_email

  @@map("tipo_token")
}

enum TipoModeloMensagem {
  lembrete
  confirmacao
  retorno
  aniversario
  boas_vindas
  fora_horario
  nao_entendi
  nao_entendi_de_novo
  transferencia
  encerramento
  saida_avisos
  volta_avisos
  convite_avisos
  pesquisa_atendimento
  pesquisa_barbearia
  pesquisa_comentario
  pesquisa_obrigado
  lembrete_primeiro
  lembrete_segundo
  atendente_sem_resposta
  convite_google
  convite_retorno
  parabens
  aviso_clube

  @@map("tipo_modelo_mensagem")
}

enum DirecaoMensagem {
  entrada
  saida

  @@map("direcao_mensagem")
}

enum StatusMensagem {
  recebida
  pendente
  enviada
  falhou
  descartada

  @@map("status_mensagem")
}

// ─── Conta e acesso ───────────────────────────────────────────────────────

/// Raiz do isolamento multiempresa. O RLS compara o próprio id com app.conta_id.
model Conta {
  id                      String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nome                    String
  logoUrl                 String?       @map("logo_url")
  plano                   Plano         @default(basico)
  status                  StatusConta   @default(teste)
  /// Esconde o telefone do cliente na tela do barbeiro (docs: matriz de permissões).
  ocultarTelefoneBarbeiro Boolean       @default(true) @map("ocultar_telefone_barbeiro")
  /// O barbeiro também digita o valor de serviço com preço livre (padrão: só o balcão).
  precoLivreBarbeiro      Boolean       @default(false) @map("preco_livre_barbeiro")
  /// Quando o dono terminou a configuração guiada (null = ainda não terminou).
  configuradaEm           DateTime?     @map("configurada_em") @db.Timestamptz(3)
  ciclo                   CicloCobranca @default(mensal)
  /// Fim do teste grátis (null = não está em teste).
  testeAte                DateTime?     @map("teste_ate") @db.Timestamptz(3)
  /// Pesquisa de 1 a 5 pelo WhatsApp depois do atendimento (o dono pode desligar).
  pesquisaPosAtendimento  Boolean       @default(true) @map("pesquisa_pos_atendimento")
  /// Automações do pós-atendimento (retorno, aniversário); JSON validado em packages/shared/src/automacoes.ts.
  automacoes              Json          @default("{}")
  /// Pix da barbearia para a mensalidade do clube (chave, nome e cidade de quem recebe).
  pix                     Json?
  /// CPF ou CNPJ de quem paga a assinatura (só dígitos); o Asaas exige.
  documento               String?
  /// Cliente e assinatura no Asaas (cobrança automática, Etapa 10.1 em teste e 23).
  asaasClienteId          String?       @unique @map("asaas_cliente_id")
  asaasAssinaturaId       String?       @unique @map("asaas_assinatura_id")
  /// Cancelamento (pela administração ou pelo dono): quando e o motivo informado (cancelamentos do mês).
  /// Quem da plataforma vendeu (venda presencial); sem chave estrangeira: a tabela da plataforma
  /// fica fora do alcance da aplicação.
  vendedorId              String?       @map("vendedor_id") @db.Uuid
  /// Data da tabela de preços contratada (assinatura ou última troca de plano); null = a do lançamento.
  precosDesde             DateTime?     @map("precos_desde") @db.Date
  /// De onde veio o cadastro (gclid, gbraid, wbraid, utm_*, domínio de origem): site T2 e admin
  /// F2. Só parâmetros de campanha, nunca dado pessoal.
  origem                  Json?
  /// Conta da própria equipe (testes, demonstração, implantação): fora do MRR, das métricas,
  /// do "Precisa de atenção" e da cobrança manual (admin R5).
  interna                 Boolean       @default(false)
  /// O que a conta era antes de a administração bloquear (desbloquear volta exatamente a isso).
  statusAnterior          StatusConta?  @map("status_anterior")
  /// Cortesia: ativa sem cobrança até esta data (inclusive), com motivo na auditoria.
  cortesiaAte             DateTime?     @map("cortesia_ate") @db.Date
  /// Cobrança manual começa nesta data (reativação, fim da cortesia ou decisão da administração).
  cobrarAPartirDe         DateTime?     @map("cobrar_a_partir_de") @db.Date
  /// Cupom usado ao contratar e o desconto dele (pontos-base), enquanto a assinatura existir.
  cupom                   String?
  descontoBp              Int           @default(0) @map("desconto_bp")
  canceladaEm             DateTime?     @map("cancelada_em") @db.Timestamptz(3)
  motivoCancelamento      String?       @map("motivo_cancelamento")
  criadoEm                DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm            DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  unidades             Unidade[]
  calendarios          CalendarioUnidade[]
  usuarios             Usuario[]
  papeis               PapelUsuario[]
  profissionais        Profissional[]
  horarios             HorarioProfissional[]
  bloqueios            BloqueioAgenda[]
  regrasComissao       RegraComissao[]
  servicos             Servico[]
  precosServico        PrecoServico[]
  produtos             Produto[]
  clientes             Cliente[]
  notasCliente         NotaCliente[]
  agendamentos         Agendamento[]
  comandas             Comanda[]
  itensComanda         ItemComanda[]
  pagamentos           Pagamento[]
  caixas               CaixaDia[]
  categoriasDespesa    CategoriaDespesa[]
  despesas             Despesa[]
  pagamentosComissao   PagamentoComissao[]
  metas                Meta[]
  auditorias           Auditoria[]
  botConexoes          BotConexao[]
  botMenus             BotMenu[]
  modelosMensagem      ModeloMensagem[]
  botSessoes           BotSessao[]
  mensagens            Mensagem[]
  tokenAcessos         TokenAcesso[]
  avaliacoes           Avaliacao[]
  faturas              FaturaAssinatura[]
  notasFiscais         NotaFiscalMensalidade[]
  assistentes          AssistenteEquipe[]
  linksHorario         LinkHorario[]
  tokensAgendamento    TokenAgendamento[]
  inscricoesPush       InscricaoPush[]
  itensClube           ItemClube[]
  servicosClube        ItemClubeServico[]
  adesoesClube         AdesaoClube[]
  pagamentosClube      PagamentoClube[]
  recebimentoOnline    RecebimentoOnline?
  assinaturasClube     AssinaturaClubeOnline[]
  listaEspera          ListaEspera[]
  bloqueiosRecorrentes BloqueioRecorrente[]
  avisos               Aviso[]

  @@map("conta")
}

model Unidade {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId             String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  nome                String
  endereco            String?
  telefone            String?
  /// Dias da semana com expediente: 0 = domingo … 6 = sábado.
  diasTrabalho        Int[]    @default([1, 2, 3, 4, 5, 6]) @map("dias_trabalho")
  /// Cadeiras atendendo ao mesmo tempo; alimenta a ocupação.
  capacidade          Int      @default(1)
  fuso                String   @default("America/Sao_Paulo")
  ativa               Boolean  @default(true)
  /// Endereço do link público de agendamento (/agendar?u=slug). Único no sistema.
  slug                String?  @unique
  /// Link público ligado: só então a página de agendamento responde.
  agendamentoPublico  Boolean  @default(false) @map("agendamento_publico")
  /// [DECISÃO DO DONO] A página da unidade (/b/slug) aparece no Google. Desligado (padrão), fica
  /// fora da busca (noindex) e do sitemap (painel P4).
  aparecerNoGoogle    Boolean  @default(false) @map("aparecer_no_google")
  /// Regras de agendamento (antecedência, janela, prazos, intervalo, lembretes). JSON validado
  /// em packages/shared (regras-agendamento.ts); vazio = padrão.
  regrasAgendamento   Json     @default("{}") @map("regras_agendamento")
  /// Link para o cliente avaliar a unidade no Google (convite depois de nota 5).
  linkAvaliacaoGoogle String?  @map("link_avaliacao_google")
  /// Horário do bot: lista de turnos (TurnoBot). Vazio = segue o expediente da equipe.
  botHorario          Json?    @map("bot_horario")
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta             Conta               @relation(fields: [contaId], references: [id], onDelete: Cascade)
  calendario        CalendarioUnidade[]
  papeis            PapelUsuario[]
  profissionais     Profissional[]
  precosServico     PrecoServico[]
  clientesOrigem    Cliente[]
  agendamentos      Agendamento[]
  comandas          Comanda[]
  caixas            CaixaDia[]
  despesas          Despesa[]
  metas             Meta[]
  botConexao        BotConexao?
  modelosMensagem   ModeloMensagem[]
  botSessoes        BotSessao[]
  mensagens         Mensagem[]
  avaliacoes        Avaliacao[]
  assistentes       AssistenteEquipe[]
  tokenAgendamentos TokenAgendamento[]

  itensClube ItemClube[]

  listaEspera ListaEspera[]
  avisos      Aviso[]

  @@index([contaId])
  @@map("unidade")
}

/// Exceções ao expediente padrão (feriado, folga, dia extra). Base da projeção.
model CalendarioUnidade {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId    String   @map("unidade_id") @db.Uuid
  data         DateTime @db.Date
  trabalha     Boolean
  motivo       String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([unidadeId, data])
  @@index([contaId])
  @@map("calendario_unidade")
}

/// E-mail único no sistema todo: o login acha a conta pelo e-mail.
model Usuario {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId            String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  nome               String
  email              String    @unique
  telefone           String?
  senhaHash          String?   @map("senha_hash")
  /// Quais avisos vão para o celular e se o resumo do dia vai por e-mail (packages/shared/src/avisos.ts).
  preferenciasAvisos Json      @default("{}") @map("preferencias_avisos")
  /// E-mail confirmado. Só o cadastro pelo site nasce sem (null): até confirmar, não agenda,
  /// não convida a equipe nem conecta o WhatsApp. Convite, venda e demonstração já nascem com.
  emailConfirmadoEm  DateTime? @default(now()) @map("email_confirmado_em") @db.Timestamptz(3)
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta                 Conta               @relation(fields: [contaId], references: [id], onDelete: Cascade)
  papeis                PapelUsuario[]
  profissionais         Profissional[]
  notasCliente          NotaCliente[]
  agendamentosCriados   Agendamento[]       @relation("AgendamentoCriadoPor")
  comandasFechadas      Comanda[]           @relation("ComandaFechadaPor")
  comandasConfirmadas   Comanda[]           @relation("ComandaConfirmadaPor")
  botMenusPublicados    BotMenu[]           @relation("BotMenuPublicadoPor")
  pagamentosRecebidos   Pagamento[]
  caixasAbertos         CaixaDia[]          @relation("CaixaAbertoPor")
  caixasFechados        CaixaDia[]          @relation("CaixaFechadoPor")
  comissoesPagas        PagamentoComissao[]
  auditorias            Auditoria[]
  tokenAcessos          TokenAcesso[]
  assistente            AssistenteEquipe?
  inscricoesPush        InscricaoPush[]
  avaliacoesTratadas    Avaliacao[]         @relation("AvaliacaoTratadaPor")
  adesoesCriadas        AdesaoClube[]       @relation("AdesaoCriadaPor")
  mensalidadesRecebidas PagamentoClube[]
  avisos                Aviso[]

  @@index([contaId])
  @@map("usuario")
}

/// Unidade vazia = o papel vale em todas as unidades da conta.
model PapelUsuario {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  papel        Papel
  unidadeId    String?  @map("unidade_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade Unidade? @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([usuarioId])
  @@map("papel_usuario")
}

/// Tokens opacos de uso único: renovação de sessão, redefinição de senha e convite.
/// Só o hash SHA-256 fica no banco. A API acha o token pelo hash antes de saber a
/// conta, por isso a migração "autenticacao" libera a leitura pelo hash da sessão.
model TokenAcesso {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId    String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tipo       TipoToken
  hash       String    @unique
  /// Tokens de renovação da mesma sessão (rotação) compartilham a família.
  familia    String?   @db.Uuid
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(3)
  usadoEm    DateTime? @map("usado_em") @db.Timestamptz(3)
  revogadoEm DateTime? @map("revogado_em") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([usuarioId, tipo])
  @@index([familia])
  @@map("token_acesso")
}

// ─── Equipe ───────────────────────────────────────────────────────────────

/// Barbeiro é cadastro, não coluna: um usuário pode atender em mais de uma unidade.
model Profissional {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId         String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId       String    @map("usuario_id") @db.Uuid
  unidadeId       String    @map("unidade_id") @db.Uuid
  dataEntrada     DateTime  @map("data_entrada") @db.Date
  dataSaida       DateTime? @map("data_saida") @db.Date
  /// Valor fixo por mês além da comissão (salário, ajuda de custo), em centavos; entra no custo do barbeiro no relatório.
  custoFixoMensal Int       @default(0) @map("custo_fixo_mensal")
  ativo           Boolean   @default(true)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta              Conta                 @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario            Usuario               @relation(fields: [usuarioId], references: [id], onDelete: NoAction)
  unidade            Unidade               @relation(fields: [unidadeId], references: [id], onDelete: NoAction)
  horarios           HorarioProfissional[]
  bloqueios          BloqueioAgenda[]
  regrasComissao     RegraComissao[]
  notasCliente       NotaCliente[]
  agendamentos       Agendamento[]
  comandas           Comanda[]
  itensComanda       ItemComanda[]
  pagamentosComissao PagamentoComissao[]
  avaliacoes         Avaliacao[]

  listaEspera ListaEspera[]

  bloqueiosRecorrentes BloqueioRecorrente[]

  @@unique([usuarioId, unidadeId])
  @@index([contaId])
  @@index([unidadeId])
  @@map("profissional")
}

/// Expediente semanal. Minutos desde a meia-noite, no fuso da unidade.
model HorarioProfissional {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  profissionalId String   @map("profissional_id") @db.Uuid
  /// 0 = domingo … 6 = sábado.
  diaSemana      Int      @map("dia_semana")
  inicioMin      Int      @map("inicio_min")
  fimMin         Int      @map("fim_min")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([profissionalId, diaSemana])
  @@map("horario_profissional")
}

/// Almoço, folga, compromisso: tira o horário da agenda.
model BloqueioAgenda {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  profissionalId String   @map("profissional_id") @db.Uuid
  inicio         DateTime @db.Timestamptz(3)
  fim            DateTime @db.Timestamptz(3)
  motivo         String?
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([profissionalId, inicio])
  @@map("bloqueio_agenda")
}

/// Percentual (pontos-base) ou valor fixo, nunca os dois. Vale a partir de vigencia_inicio.
model RegraComissao {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String           @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  profissionalId String           @map("profissional_id") @db.Uuid
  tipoItem       TipoItemComissao @map("tipo_item")
  percentualBp   Int?             @map("percentual_bp")
  valorFixo      Int?             @map("valor_fixo")
  vigenciaInicio DateTime         @map("vigencia_inicio") @db.Date
  criadoEm       DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, tipoItem, vigenciaInicio])
  @@index([contaId])
  @@map("regra_comissao")
}

// ─── Catálogo ─────────────────────────────────────────────────────────────

/// Peso: principal 1, extra 0, combo = soma dos inclusos. Define "atendimentos".
model Servico {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId         String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  nome            String
  categoria       String?
  duracaoMin      Int      @map("duracao_min")
  /// Custo de produto gasto no serviço, em centavos.
  custoProduto    Int      @default(0) @map("custo_produto")
  ehExtra         Boolean  @default(false) @map("eh_extra")
  pesoAtendimento Int      @default(1) @map("peso_atendimento")
  ativo           Boolean  @default(true)
  /// Química e afins: o valor é digitado na comanda; a tabela vira o valor sugerido.
  precoLivre      Boolean  @default(false) @map("preco_livre")
  /// Faixa do preço livre, em centavos (null = sem limite).
  precoMinimo     Int?     @map("preco_minimo")
  precoMaximo     Int?     @map("preco_maximo")
  /// Unidades em que o serviço está ("Disponível em"). Vazio = em nenhuma.
  unidadeIds      String[] @default([]) @map("unidade_ids") @db.Uuid
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta  Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  precos PrecoServico[]
  itens  ItemComanda[]
  metas  Meta[]
  clube  ItemClubeServico[]

  @@unique([contaId, nome])
  @@index([unidadeIds], type: Gin)
  @@map("servico")
}

/// Uma linha por mudança de preço. O preço vigente é a maior vigência até a data.
model PrecoServico {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  servicoId      String   @map("servico_id") @db.Uuid
  unidadeId      String   @map("unidade_id") @db.Uuid
  valor          Int
  vigenciaInicio DateTime @map("vigencia_inicio") @db.Date
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([contaId, servicoId, unidadeId, vigenciaInicio])
  @@map("preco_servico")
}

model Produto {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  nome         String
  categoria    String?
  fotoUrl      String?  @map("foto_url")
  precoVenda   Int      @map("preco_venda")
  custo        Int      @default(0)
  ativo        Boolean  @default(true)
  /// Unidades em que o produto está ("Disponível em"). Vazio = em nenhuma.
  unidadeIds   String[] @default([]) @map("unidade_ids") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  itens ItemComanda[]

  @@unique([contaId, nome])
  @@index([unidadeIds], type: Gin)
  @@map("produto")
}

// ─── Clientes ─────────────────────────────────────────────────────────────

/// Telefone em dígitos com DDI (5511999998888); único por conta quando informado.
model Cliente {
  id                   String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId              String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  nome                 String
  telefone             String?
  email                String?
  aniversario          DateTime? @db.Date
  unidadeOrigemId      String?   @map("unidade_origem_id") @db.Uuid
  origemLead           String?   @map("origem_lead")
  etapaLead            String?   @map("etapa_lead")
  consentimentoMsg     Boolean   @default(false) @map("consentimento_msg")
  /// Quando o cliente escolheu (RECEBER ou SAIR). Vazio = ainda não escolheu: o bot convida.
  consentimentoEm      DateTime? @map("consentimento_em") @db.Timestamptz(3)
  /// Último convite de retorno (um por ciclo: só de novo depois de outra visita).
  retornoConvidadoEm   DateTime? @map("retorno_convidado_em") @db.Timestamptz(3)
  /// Último parabéns (um por ano).
  aniversarioEnviadoEm DateTime? @map("aniversario_enviado_em") @db.Timestamptz(3)
  /// Por onde marcou da última vez: "conversa" (bot) ou "site". O bot segue por ele.
  canalPreferido       String?   @map("canal_preferido")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta             Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidadeOrigem     Unidade?           @relation(fields: [unidadeOrigemId], references: [id], onDelete: SetNull)
  notas             NotaCliente[]
  agendamentos      Agendamento[]
  comandas          Comanda[]
  mensagens         Mensagem[]
  sessoesBot        BotSessao[]
  avaliacoes        Avaliacao[]
  tokenAgendamentos TokenAgendamento[]

  adesoesClube           AdesaoClube[]
  assinaturasClubeOnline AssinaturaClubeOnline[]

  listaEspera ListaEspera[]

  @@unique([contaId, telefone])
  @@index([contaId, nome])
  @@map("cliente")
}

model NotaCliente {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  clienteId      String   @map("cliente_id") @db.Uuid
  profissionalId String?  @map("profissional_id") @db.Uuid
  autorId        String?  @map("autor_id") @db.Uuid
  texto          String
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  autor        Usuario?      @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([clienteId])
  @@map("nota_cliente")
}

// ─── Agenda e comanda ─────────────────────────────────────────────────────

/// Cria a comanda prevista. Dois agendamentos ativos do mesmo profissional não se
/// sobrepõem (restrição de exclusão na migração "restricoes").
model Agendamento {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String            @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId      String            @map("unidade_id") @db.Uuid
  profissionalId String            @map("profissional_id") @db.Uuid
  clienteId      String?           @map("cliente_id") @db.Uuid
  inicio         DateTime          @db.Timestamptz(3)
  fim            DateTime          @db.Timestamptz(3)
  status         StatusAgendamento @default(agendado)
  origem         OrigemAgendamento @default(balcao)
  observacao     String?
  criadoPorId    String?           @map("criado_por_id") @db.Uuid
  /// Lembretes pelo WhatsApp já enviados (Etapa 11); null = ainda não.
  lembrete24hEm  DateTime?         @map("lembrete_24h_em") @db.Timestamptz(3)
  lembrete2hEm   DateTime?         @map("lembrete_2h_em") @db.Timestamptz(3)
  /// O cliente respondeu "Confirmo" ao lembrete.
  confirmadoEm   DateTime?         @map("confirmado_em") @db.Timestamptz(3)
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  /// Falta por atraso ("Não veio" depois da tolerância): conta nas faltas, mas separada da comum.
  atrasou      Boolean      @default(false)
  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade      Unidade      @relation(fields: [unidadeId], references: [id], onDelete: NoAction)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  cliente      Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  criadoPor    Usuario?     @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  link         LinkHorario?
  comanda      Comanda?

  listaEspera ListaEspera[]

  @@index([contaId])
  @@index([profissionalId, inicio])
  @@index([unidadeId, inicio])
  @@map("agendamento")
}

/// Só comanda fechada entra em faturamento, comissão e indicadores.
model Comanda {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId            String        @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId          String        @map("unidade_id") @db.Uuid
  clienteId          String?       @map("cliente_id") @db.Uuid
  profissionalId     String        @map("profissional_id") @db.Uuid
  agendamentoId      String?       @unique @map("agendamento_id") @db.Uuid
  status             StatusComanda @default(prevista)
  totalBruto         Int           @default(0) @map("total_bruto")
  desconto           Int           @default(0)
  totalLiquido       Int           @default(0) @map("total_liquido")
  iniciadaEm         DateTime?     @map("iniciada_em") @db.Timestamptz(3)
  confirmadaEm       DateTime?     @map("confirmada_em") @db.Timestamptz(3)
  /// Quem apertou "confirmar" (vazio = a recepção fechou sem confirmação).
  confirmadaPorId    String?       @map("confirmada_por_id") @db.Uuid
  fechadaEm          DateTime?     @map("fechada_em") @db.Timestamptz(3)
  fechadaPorId       String?       @map("fechada_por_id") @db.Uuid
  canceladaEm        DateTime?     @map("cancelada_em") @db.Timestamptz(3)
  motivoCancelamento String?       @map("motivo_cancelamento")
  /// Já entrou num aviso de "comanda pendente" para a recepção (não repete).
  pendenteAvisadaEm  DateTime?     @map("pendente_avisada_em") @db.Timestamptz(3)
  criadoEm           DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta         Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade       Unidade       @relation(fields: [unidadeId], references: [id], onDelete: NoAction)
  cliente       Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  profissional  Profissional  @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  agendamento   Agendamento?  @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  fechadaPor    Usuario?      @relation("ComandaFechadaPor", fields: [fechadaPorId], references: [id], onDelete: SetNull)
  confirmadaPor Usuario?      @relation("ComandaConfirmadaPor", fields: [confirmadaPorId], references: [id], onDelete: SetNull)
  itens         ItemComanda[]
  pagamentos    Pagamento[]
  avaliacao     Avaliacao?

  @@index([contaId])
  @@index([unidadeId, status, fechadaEm])
  @@index([profissionalId, status])
  @@map("comanda")
}

/// Grava preço, custo, peso e comissão do momento: mudanças futuras não reescrevem o passado.
model ItemComanda {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId              String          @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  comandaId            String          @map("comanda_id") @db.Uuid
  tipo                 TipoItemComanda
  servicoId            String?         @map("servico_id") @db.Uuid
  produtoId            String?         @map("produto_id") @db.Uuid
  /// Obrigatória para receita não operacional; opcional nos demais.
  descricao            String?
  profissionalId       String?         @map("profissional_id") @db.Uuid
  quantidade           Int             @default(1)
  precoUnitario        Int             @map("preco_unitario")
  desconto             Int             @default(0)
  /// Custo de produto por unidade no momento do lançamento.
  custoUnitario        Int             @default(0) @map("custo_unitario")
  cobertoClube         Boolean         @default(false) @map("coberto_clube")
  /// Adesão do clube que cobriu o item (conta no uso do ciclo).
  adesaoId             String?         @map("adesao_id") @db.Uuid
  ehExtra              Boolean         @default(false) @map("eh_extra")
  pesoAtendimento      Int             @default(0) @map("peso_atendimento")
  comissaoPercentualBp Int?            @map("comissao_percentual_bp")
  comissaoValorFixo    Int?            @map("comissao_valor_fixo")
  comissaoValor        Int             @default(0) @map("comissao_valor")
  criadoEm             DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  comanda      Comanda       @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  servico      Servico?      @relation(fields: [servicoId], references: [id], onDelete: NoAction)
  produto      Produto?      @relation(fields: [produtoId], references: [id], onDelete: NoAction)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  adesao       AdesaoClube?  @relation(fields: [adesaoId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([comandaId])
  @@index([profissionalId, criadoEm])
  @@map("item_comanda")
}

model Pagamento {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId       String         @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  comandaId     String         @map("comanda_id") @db.Uuid
  forma         FormaPagamento
  valor         Int
  recebidoPorId String?        @map("recebido_por_id") @db.Uuid
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta       Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  comanda     Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  recebidoPor Usuario? @relation(fields: [recebidoPorId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([comandaId])
  @@map("pagamento")
}

// ─── Financeiro ───────────────────────────────────────────────────────────

model CaixaDia {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId      String    @map("unidade_id") @db.Uuid
  data           DateTime  @db.Date
  /// Troco deixado na gaveta ao abrir, em centavos.
  valorAbertura  Int       @default(0) @map("valor_abertura")
  abertoPorId    String?   @map("aberto_por_id") @db.Uuid
  abertoEm       DateTime  @default(now()) @map("aberto_em") @db.Timestamptz(3)
  fechadoPorId   String?   @map("fechado_por_id") @db.Uuid
  fechadoEm      DateTime? @map("fechado_em") @db.Timestamptz(3)
  totalSistema   Int?      @map("total_sistema")
  totalInformado Int?      @map("total_informado")
  divergencia    Int?
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta      Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade    Unidade  @relation(fields: [unidadeId], references: [id], onDelete: NoAction)
  abertoPor  Usuario? @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id], onDelete: SetNull)
  fechadoPor Usuario? @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id], onDelete: SetNull)

  @@unique([unidadeId, data])
  @@index([contaId])
  @@map("caixa_dia")
}

/// Investimento, retirada do dono e cartão/resgates ficam fora do % operacional.
model CategoriaDespesa {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String       @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  nome         String
  grupo        GrupoDespesa
  ativa        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta    Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  despesas Despesa[]

  @@unique([contaId, nome])
  @@map("categoria_despesa")
}

/// Unidade vazia = despesa da conta (rateio fica para os relatórios).
model Despesa {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId    String?   @map("unidade_id") @db.Uuid
  categoriaId  String    @map("categoria_id") @db.Uuid
  descricao    String
  valor        Int
  /// Mês a que a despesa pertence (primeiro dia do mês).
  competencia  DateTime  @db.Date
  vencimento   DateTime? @db.Date
  pago         Boolean   @default(false)
  pagoEm       DateTime? @map("pago_em") @db.Timestamptz(3)
  /// "Repetir todo mês": a rotina diária lança a cópia no mês seguinte.
  repetir      Boolean   @default(false)
  /// Despesa do mês anterior de onde esta foi copiada (única: nunca duas cópias da mesma).
  origemId     String?   @unique @map("origem_id") @db.Uuid
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta     Conta            @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade   Unidade?         @relation(fields: [unidadeId], references: [id], onDelete: NoAction)
  categoria CategoriaDespesa @relation(fields: [categoriaId], references: [id], onDelete: NoAction)
  origem    Despesa?         @relation("CopiaDespesa", fields: [origemId], references: [id], onDelete: SetNull)
  copia     Despesa?         @relation("CopiaDespesa")

  @@index([contaId, competencia])
  @@index([unidadeId, competencia])
  @@map("despesa")
}

model PagamentoComissao {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  profissionalId String   @map("profissional_id") @db.Uuid
  periodoInicio  DateTime @map("periodo_inicio") @db.Date
  periodoFim     DateTime @map("periodo_fim") @db.Date
  valor          Int
  pagoEm         DateTime @default(now()) @map("pago_em") @db.Timestamptz(3)
  pagoPorId      String?  @map("pago_por_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  pagoPor      Usuario?     @relation(fields: [pagoPorId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([profissionalId, periodoInicio])
  @@map("pagamento_comissao")
}

/// O valor atual é calculado, não guardado.
model Meta {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId    String   @map("unidade_id") @db.Uuid
  /// Primeiro dia do mês.
  mes          DateTime @db.Date
  tipo         TipoMeta
  servicoId    String?  @map("servico_id") @db.Uuid
  /// Centavos (faturamento) ou quantidade (serviço).
  objetivo     Int
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  servico Servico? @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([unidadeId, mes])
  @@map("meta")
}

/// Imutável: um gatilho recusa UPDATE e DELETE (migração "restricoes").
model Auditoria {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId    String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  entidade   String
  entidadeId String   @map("entidade_id") @db.Uuid
  acao       String
  antes      Json?
  depois     Json?
  motivo     String?
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: NoAction)

  @@index([contaId, entidade, entidadeId])
  @@map("auditoria")
}

// ─── Bot do WhatsApp (sem IA) ─────────────────────────────────────────────

/// Um número por unidade. "instancia" é o nome da instância na Evolution API.
model BotConexao {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String           @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId    String           @unique @map("unidade_id") @db.Uuid
  provedor     String           @default("evolution")
  instancia    String           @unique
  numero       String?
  status       StatusBotConexao @default(desconectado)
  /// A conexão caiu sem o dono pedir: o painel avisa até reconectar.
  caiuEm       DateTime?        @map("caiu_em") @db.Timestamptz(3)
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@map("bot_conexao")
}

/// Onde cada número está no menu do bot. Sem resposta por 30 minutos, recomeça.
model BotSessao {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId      String    @map("unidade_id") @db.Uuid
  telefone       String
  clienteId      String?   @map("cliente_id") @db.Uuid
  sessao         Json
  /// Pediu atendente e espera a recepção (tela Conversas). Volta a null ao devolver ao bot.
  atendenteDesde DateTime? @map("atendente_desde") @db.Timestamptz(3)
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@unique([unidadeId, telefone])
  @@index([contaId])
  @@index([unidadeId, atualizadoEm])
  @@map("bot_sessao")
}

/// Mensagens do WhatsApp, recebidas e enviadas. Histórico no perfil do cliente.
model Mensagem {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId   String          @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId String          @map("unidade_id") @db.Uuid
  clienteId String?         @map("cliente_id") @db.Uuid
  telefone  String
  direcao   DirecaoMensagem
  texto     String
  status    StatusMensagem
  /// Id da mensagem no WhatsApp (recebida) ou no provedor (enviada).
  idExterno String?         @map("id_externo")
  erro      String?
  enviadaEm DateTime?       @map("enviada_em") @db.Timestamptz(3)
  /// Automação que gerou a mensagem (retorno, aniversario, pesquisa, lembrete), para os números.
  automacao String?
  criadoEm  DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@unique([unidadeId, idExterno])
  @@index([contaId, clienteId, criadoEm])
  @@index([unidadeId, telefone, criadoEm])
  @@map("mensagem")
}

/// Versões do menu do bot (sem IA). Uma em rascunho e uma publicada por conta; as
/// publicadas antes ficam arquivadas para "voltar à versão anterior". O menu é um documento
/// (MenuBot de @pente-fino/shared), validado antes de publicar.
model BotMenu {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String        @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  status         StatusMenuBot
  menu           Json
  publicadoEm    DateTime?     @map("publicado_em") @db.Timestamptz(3)
  publicadoPorId String?       @map("publicado_por_id") @db.Uuid
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  publicadoPor Usuario? @relation("BotMenuPublicadoPor", fields: [publicadoPorId], references: [id], onDelete: SetNull)

  @@index([contaId, status])
  @@map("bot_menu")
}

/// Texto com variáveis entre chaves: {cliente}, {data}, {hora}, {profissional}, {unidade}.
/// Unidade vazia = modelo padrão da conta.
model ModeloMensagem {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String             @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId    String?            @map("unidade_id") @db.Uuid
  tipo         TipoModeloMensagem
  texto        String
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade? @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@map("modelo_mensagem")
}

enum StatusAvaliacao {
  /// Criada no fechamento, esperando a hora de sair.
  agendada
  enviada
  /// Deu ao menos a nota do atendimento.
  respondida
  /// Não saiu (cliente saiu dos avisos, WhatsApp caído, comanda reaberta) ou passou do prazo.
  cancelada

  @@map("status_avaliacao")
}

/// Pesquisa depois do atendimento: uma por comanda, notas de 1 a 5 e comentário.
model Avaliacao {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId         String          @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId       String          @map("unidade_id") @db.Uuid
  comandaId       String          @unique @map("comanda_id") @db.Uuid
  profissionalId  String          @map("profissional_id") @db.Uuid
  clienteId       String          @map("cliente_id") @db.Uuid
  /// Número que conversou com a barbearia (é para ele que a pesquisa sai).
  telefone        String
  status          StatusAvaliacao @default(agendada)
  notaAtendimento Int?            @map("nota_atendimento")
  notaBarbearia   Int?            @map("nota_barbearia")
  comentario      String?
  enviarEm        DateTime        @map("enviar_em") @db.Timestamptz(3)
  enviadaEm       DateTime?       @map("enviada_em") @db.Timestamptz(3)
  respondidaEm    DateTime?       @map("respondida_em") @db.Timestamptz(3)
  expiraEm        DateTime        @map("expira_em") @db.Timestamptz(3)
  motivo          String?
  /// Nota 1 ou 2: quando o aviso saiu para dono e gestor (só uma vez por avaliação).
  gestaoAvisadaEm DateTime?       @map("gestao_avisada_em") @db.Timestamptz(3)
  /// Nota baixa tratada: quando, por quem e o que foi feito (falou com o cliente, desconto…).
  tratadaEm       DateTime?       @map("tratada_em") @db.Timestamptz(3)
  tratadaPorId    String?         @map("tratada_por_id") @db.Uuid
  tratamento      String?
  criadoEm        DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade      Unidade      @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  comanda      Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tratadaPor   Usuario?     @relation("AvaliacaoTratadaPor", fields: [tratadaPorId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([profissionalId, respondidaEm])
  @@index([unidadeId, respondidaEm])
  @@index([clienteId, criadoEm])
  @@map("avaliacao")
}

enum StatusFatura {
  aberta
  paga
  /// Cobrança no cartão recusada (motivo em motivo_recusa).
  recusada
  cancelada

  @@map("status_fatura")
}

enum FormaPagamentoFatura {
  pix
  cartao
  boleto
  dinheiro
  transferencia

  @@map("forma_pagamento_fatura")
}

enum OrigemFatura {
  /// Cobrança automática (Asaas, Etapa 23).
  asaas
  /// Registrada pela administração (venda presencial, Etapa 15.1).
  manual

  @@map("origem_fatura")
}

/// Faturas da assinatura do Pente Fino pela barbearia. A conta só lê; quem grava é o sistema
/// (cobrança automática ou a administração).
model FaturaAssinatura {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId       String                @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  plano         Plano
  ciclo         CicloCobranca
  /// Centavos.
  valor         Int
  vencimento    DateTime              @db.Date
  periodoInicio DateTime              @map("periodo_inicio") @db.Date
  periodoFim    DateTime              @map("periodo_fim") @db.Date
  status        StatusFatura          @default(aberta)
  origem        OrigemFatura          @default(asaas)
  forma         FormaPagamentoFatura?
  pagaEm        DateTime?             @map("paga_em") @db.Timestamptz(3)
  motivoRecusa  String?               @map("motivo_recusa")
  /// Página de pagamento (Pix, boleto ou cartão) do provedor.
  linkPagamento String?               @map("link_pagamento")
  idExterno     String?               @map("id_externo")
  /// Pagamento manual: quem da plataforma recebeu (sem chave estrangeira) e o comprovante.
  recebidoPorId String?               @map("recebido_por_id") @db.Uuid
  comprovante   String?
  criadoEm      DateTime              @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@unique([origem, idExterno])
  @@index([contaId, vencimento])
  @@map("fatura_assinatura")
}

enum StatusNotaFiscal {
  agendada
  /// Enviada à prefeitura, esperando a autorização.
  enviada
  emitida
  /// A prefeitura ou o Asaas recusou (mensagem em mensagem).
  erro
  cancelando
  cancelada

  @@map("status_nota_fiscal")
}

/// Nota fiscal (NFS-e) de uma mensalidade do Pente Fino, emitida pelo Asaas e acompanhada pelo
/// webhook (admin R2). Liga com a fatura pelo pagamento do Asaas (fatura_assinatura.id_externo).
model NotaFiscalMensalidade {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String           @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  /// Id da nota no Asaas (inv_…).
  idExterno    String           @unique @map("id_externo")
  /// Pagamento do Asaas que a nota cobre (pay_…).
  pagamentoId  String?          @map("pagamento_id")
  status       StatusNotaFiscal
  numero       String?
  /// Centavos.
  valor        Int?
  pdfUrl       String?          @map("pdf_url")
  xmlUrl       String?          @map("xml_url")
  /// O que o Asaas ou a prefeitura disse quando a nota não saiu.
  mensagem     String?
  emitidaEm    DateTime?        @map("emitida_em") @db.Timestamptz(3)
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, pagamentoId])
  @@map("nota_fiscal_mensalidade")
}

/// Assistente da equipe no WhatsApp (Etapa 11): o profissional confirma o próprio número
/// mandando um código para o WhatsApp da unidade e recebe avisos da agenda dele.
model AssistenteEquipe {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId      String    @unique @map("usuario_id") @db.Uuid
  unidadeId      String    @map("unidade_id") @db.Uuid
  /// Número confirmado (como chega do WhatsApp); null até mandar o código.
  telefone       String?
  /// SHA-256 do código de 6 dígitos (o código em si nunca fica gravado).
  codigoHash     String?   @map("codigo_hash")
  codigoExpiraEm DateTime? @map("codigo_expira_em") @db.Timestamptz(3)
  confirmadoEm   DateTime? @map("confirmado_em") @db.Timestamptz(3)
  /// Recebendo avisos; "PARAR" desliga, "LIGAR" religa.
  ativo          Boolean   @default(false)
  /// Quais avisos quer (JSON validado em packages/shared/src/assistente.ts).
  avisos         Json      @default("{}")
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([unidadeId, telefone])
  @@index([contaId])
  @@map("assistente_equipe")
}

/// Link para o cliente ver, remarcar ou cancelar o próprio horário sem login (/horario?t=token).
/// Guarda só o SHA-256 do token; um link novo substitui o anterior.
model LinkHorario {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId       String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  agendamentoId String   @unique @map("agendamento_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta       Conta       @relation(fields: [contaId], references: [id], onDelete: Cascade)
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@map("link_horario")
}

/// Link do site mandado pelo bot (/agendar?u=slug&c=token): nome e telefone já preenchidos,
/// sem dado pessoal na URL. Curto, de uso único e com validade; guarda só o hash.
model TokenAgendamento {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId   String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId String    @map("unidade_id") @db.Uuid
  clienteId String    @map("cliente_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz(3)
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz(3)
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@map("token_agendamento")
}

/// Aparelho que ligou as notificações no Perfil (push do PWA). Some quando o navegador
/// avisa que a inscrição acabou (404/410) ou a pessoa desliga.
model InscricaoPush {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId   String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  aparelho  String?
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([contaId, endpoint])
  @@index([usuarioId])
  @@map("inscricao_push")
}

/// Plano do clube numa unidade: assinatura (mensal), combo ou convênio. O valor é por ciclo.
model ItemClube {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId      String        @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId    String        @map("unidade_id") @db.Uuid
  tipo         TipoItemClube
  nome         String
  descricao    String?
  /// Valor do ciclo (mensalidade), em centavos.
  valor        Int
  /// Usos no ciclo somando todos os serviços; null = só o limite de cada serviço.
  limiteUsoMes Int?          @map("limite_uso_mes")
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta             Conta                   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade           Unidade                 @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  servicos          ItemClubeServico[]
  adesoes           AdesaoClube[]
  assinaturasOnline AssinaturaClubeOnline[]

  @@index([contaId])
  @@index([unidadeId])
  @@map("item_clube")
}

/// Serviço incluso no plano: quantas vezes por ciclo e, se o dono quiser, a comissão fixa dele.
model ItemClubeServico {
  id                String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId           String @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  itemClubeId       String @map("item_clube_id") @db.Uuid
  servicoId         String @map("servico_id") @db.Uuid
  /// Vezes por ciclo; null = sem limite próprio (vale o limite do plano).
  quantidade        Int?
  /// Comissão fixa por atendimento do clube; null = % do profissional sobre o preço de tabela.
  comissaoValorFixo Int?   @map("comissao_valor_fixo")

  conta     Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  itemClube ItemClube @relation(fields: [itemClubeId], references: [id], onDelete: Cascade)
  servico   Servico   @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@unique([itemClubeId, servicoId])
  @@index([contaId])
  @@map("item_clube_servico")
}

/// Cliente no plano: o ciclo vai do vencimento anterior (um mês antes) até o vencimento.
model AdesaoClube {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId            String       @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  clienteId          String       @map("cliente_id") @db.Uuid
  itemClubeId        String       @map("item_clube_id") @db.Uuid
  status             StatusAdesao @default(ativa)
  inicio             DateTime     @db.Date
  /// Dia em que o plano renova (próxima mensalidade); a partir dele, sem baixa, para de cobrir.
  vencimento         DateTime     @db.Date
  canceladaEm        DateTime?    @map("cancelada_em") @db.Timestamptz(3)
  motivoCancelamento String?      @map("motivo_cancelamento")
  /// Aviso de vencimento pelo bot (um por ciclo).
  avisoVencimentoEm  DateTime?    @map("aviso_vencimento_em") @db.Timestamptz(3)
  criadoPorId        String?      @map("criado_por_id") @db.Uuid
  criadoEm           DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta            Conta                  @relation(fields: [contaId], references: [id], onDelete: Cascade)
  cliente          Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itemClube        ItemClube              @relation(fields: [itemClubeId], references: [id], onDelete: Restrict)
  criadoPor        Usuario?               @relation("AdesaoCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens            ItemComanda[]
  pagamentos       PagamentoClube[]
  assinaturaOnline AssinaturaClubeOnline?

  @@index([contaId])
  @@index([clienteId, status])
  @@map("adesao_clube")
}

/// Mensalidade do clube recebida no balcão (Pix da barbearia, dinheiro ou cartão) ou online. É
/// receita do clube, separada da receita de serviço: entra no faturamento do mês no dia do
/// pagamento (repasse ?? valor), numa linha própria, mas não nas comandas nem no desempenho por
/// barbeiro.
model PagamentoClube {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId         String         @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  adesaoId        String         @map("adesao_id") @db.Uuid
  valor           Int
  forma           FormaPagamento
  pagoEm          DateTime       @map("pago_em") @db.Date
  /// Vencimento que esta mensalidade pagou (o ciclo que ela cobre começa nele).
  referenteA      DateTime       @map("referente_a") @db.Date
  recebidoPorId   String?        @map("recebido_por_id") @db.Uuid
  /// balcao (baixa pela recepção) ou online (pago pelo link, Asaas com split).
  origem          String         @default("balcao")
  /// Cobrança do Asaas (online): um pagamento por cobrança.
  idExterno       String?        @map("id_externo")
  /// Online: taxa do Asaas, parte do Pente Fino e o que vai para a barbearia (centavos).
  taxaAsaas       Int            @default(0) @map("taxa_asaas")
  taxaPlataforma  Int            @default(0) @map("taxa_plataforma")
  repasse         Int?
  /// Online: quando o Asaas prevê o crédito na conta da barbearia.
  creditoPrevisto DateTime?      @map("credito_previsto") @db.Date
  criadoEm        DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta       Conta       @relation(fields: [contaId], references: [id], onDelete: Cascade)
  adesao      AdesaoClube @relation(fields: [adesaoId], references: [id], onDelete: Cascade)
  recebidoPor Usuario?    @relation(fields: [recebidoPorId], references: [id], onDelete: SetNull)

  @@unique([contaId, idExterno])
  @@index([contaId, pagoEm])
  @@index([adesaoId])
  @@map("pagamento_clube")
}

/// Conta da barbearia para receber online (subconta do Asaas): o split manda a mensalidade
/// direto para a carteira dela. A chave de API da subconta fica cifrada (PLATAFORMA_CHAVE).
model RecebimentoOnline {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId       String   @unique @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  asaasContaId  String   @map("asaas_conta_id")
  walletId      String   @map("wallet_id")
  apiKeyCifrada String   @map("api_key_cifrada")
  /// documentos, analise, aprovada ou recusada (packages/shared/src/clube-online.ts).
  situacao      String   @default("documentos")
  nome          String
  documento     String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@map("recebimento_online")
}

/// Assinatura do clube feita pelo link (cobrança recorrente no Asaas com split). A adesão nasce
/// no primeiro pagamento e renova a cada mensalidade paga.
model AssinaturaClubeOnline {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId           String   @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  itemClubeId       String   @map("item_clube_id") @db.Uuid
  clienteId         String   @map("cliente_id") @db.Uuid
  asaasClienteId    String   @map("asaas_cliente_id")
  asaasAssinaturaId String   @unique @map("asaas_assinatura_id")
  /// aguardando (sem pagamento), ativa ou cancelada.
  status            String   @default("aguardando")
  adesaoId          String?  @unique @map("adesao_id") @db.Uuid
  /// Página de pagamento da primeira mensalidade.
  link              String?
  /// Taxa da plataforma no momento da assinatura (o split no Asaas usa esta).
  taxaBp            Int      @map("taxa_bp")
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta     Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  itemClube ItemClube    @relation(fields: [itemClubeId], references: [id], onDelete: Restrict)
  cliente   Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  adesao    AdesaoClube? @relation(fields: [adesaoId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([clienteId])
  @@map("assinatura_clube_online")
}

/// Lista de espera: o cliente quer um horário no dia, numa faixa, com um profissional (ou
/// qualquer um). Quando vaga um horário que cabe, o bot oferece na ordem de chegada.
model ListaEspera {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String       @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  unidadeId      String       @map("unidade_id") @db.Uuid
  clienteId      String       @map("cliente_id") @db.Uuid
  /// null = qualquer profissional.
  profissionalId String?      @map("profissional_id") @db.Uuid
  servicoIds     String[]     @map("servico_ids") @db.Uuid
  dia            DateTime     @db.Date
  /// Faixa em minutos desde 00:00 (São Paulo) em que o atendimento pode começar.
  deMin          Int          @map("de_min")
  ateMin         Int          @map("ate_min")
  origem         OrigemEspera
  /// "Avisar se vagar antes": o horário que o cliente já tem e quer antecipar.
  agendamentoId  String?      @map("agendamento_id") @db.Uuid
  status         StatusEspera @default(aguardando)
  /// Oferta em aberto: { inicio, profissionalId, enviadaEm }.
  oferta         Json?
  criadoPorId    String?      @map("criado_por_id") @db.Uuid
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conta        Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  unidade      Unidade       @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  agendamento  Agendamento?  @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([unidadeId, dia, status])
  @@map("lista_espera")
}

/// Bloqueio que repete toda semana (almoço de toda terça), de uma data até outra (ou sem fim).
model BloqueioRecorrente {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId        String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  profissionalId String    @map("profissional_id") @db.Uuid
  diaSemana      Int       @map("dia_semana")
  inicioMin      Int       @map("inicio_min")
  fimMin         Int       @map("fim_min")
  desde          DateTime  @db.Date
  ate            DateTime? @db.Date
  motivo         String?
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([profissionalId])
  @@map("bloqueio_recorrente")
}

/// Central de avisos (Etapa 15): o que cada pessoa precisa resolver, com histórico. Também vira
/// notificação no celular para quem ligou o push. `chave` evita repetir o mesmo aviso.
model Aviso {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contaId   String    @default(dbgenerated("conta_atual()")) @map("conta_id") @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  unidadeId String?   @map("unidade_id") @db.Uuid
  /// Tipo validado em packages/shared/src/avisos.ts.
  tipo      String
  titulo    String
  texto     String
  link      String?
  chave     String
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  lidoEm    DateTime? @map("lido_em") @db.Timestamptz(3)

  conta   Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade Unidade? @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@index([usuarioId, criadoEm])
  @@map("aviso")
}

// ─── Administração do sistema (Etapa 15.1) ────────────────────────────────
// Fora das contas: sem conta_id e sem RLS. Só o usuário de banco da plataforma lê e grava estas
// tabelas; o da aplicação não tem acesso (migração "plataforma").

enum PapelPlataforma {
  /// Tudo na administração.
  admin
  /// Cria conta, registra pagamento e vê só as contas dele.
  vendedor

  @@map("papel_plataforma")
}

/// Quem opera o Pente Fino. Nunca reaproveita o login de uma barbearia.
model UsuarioPlataforma {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nome             String
  email            String          @unique
  senhaHash        String          @map("senha_hash")
  papel            PapelPlataforma
  /// Segredo do aplicativo autenticador, cifrado (AES-256-GCM com PLATAFORMA_CHAVE).
  totpSegredo      String?         @map("totp_segredo")
  /// Segundo fator confirmado com um código válido; sem isto, o login só serve para configurar.
  totpConfirmadoEm DateTime?       @map("totp_confirmado_em") @db.Timestamptz(3)
  /// Último código aceito (passo de 30 s): o mesmo código não entra duas vezes.
  totpUltimoPasso  BigInt?         @map("totp_ultimo_passo")
  ativo            Boolean         @default(true)
  ultimoAcessoEm   DateTime?       @map("ultimo_acesso_em") @db.Timestamptz(3)
  criadoEm         DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  sessoes       SessaoPlataforma[]
  auditorias    AuditoriaPlataforma[]
  notasInternas NotaInternaConta[]

  @@map("usuario_plataforma")
}

/// Sessão curta de quem administra: só o hash do token; IP e navegador registrados.
model SessaoPlataforma {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  ip          String?
  navegador   String?
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  encerradaEm DateTime? @map("encerrada_em") @db.Timestamptz(3)

  usuario UsuarioPlataforma @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessao_plataforma")
}

/// Notas internas da equipe da plataforma sobre uma conta (admin U3): combinados, contexto da
/// venda, o que o dono pediu. A barbearia nunca vê. Fora do RLS das barbearias (como a auditoria).
model NotaInternaConta {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Conta da barbearia (sem chave estrangeira, como na auditoria).
  contaAfetadaId String   @map("conta_afetada_id") @db.Uuid
  autorId        String?  @map("autor_id") @db.Uuid
  texto          String
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  autor UsuarioPlataforma? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([contaAfetadaId, criadoEm])
  @@map("nota_interna_conta")
}

/// Toda ação de admin e vendedor: quem, quando, em que conta, antes e depois. Imutável.
model AuditoriaPlataforma {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  usuarioId      String?  @map("usuario_id") @db.Uuid
  acao           String
  /// Conta da barbearia afetada (sem chave estrangeira: o histórico fica mesmo se a conta sair).
  /// Não se chama conta_id: a tabela não pertence a uma conta (fica fora do RLS das barbearias).
  contaAfetadaId String?  @map("conta_afetada_id") @db.Uuid
  antes          Json?
  depois         Json?
  motivo         String?
  ip             String?
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario UsuarioPlataforma? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([contaAfetadaId])
  @@index([criadoEm])
  @@map("auditoria_plataforma")
}

/// Configurações do sistema, editadas na administração (chave → valor JSON validado em
/// packages/shared/src/configuracao-sistema.ts). Fora das contas: a aplicação só lê o que
/// a função configuracao_do_sistema() libera (nunca segredos).
model ConfiguracaoPlataforma {
  chave           String   @id
  valor           Json
  atualizadoEm    DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)
  /// Quem da plataforma mudou por último (sem chave estrangeira).
  atualizadoPorId String?  @map("atualizado_por_id") @db.Uuid

  @@map("configuracao_plataforma")
}

/// Execuções da rotina diária de limpeza (Etapa 15.4): quanto saiu de cada tipo. Fora do RLS
/// das barbearias (não pertence a uma conta); o worker grava e a administração lê.
model ExecucaoLimpeza {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  iniciadaEm  DateTime  @default(now()) @map("iniciada_em") @db.Timestamptz(3)
  terminadaEm DateTime? @map("terminada_em") @db.Timestamptz(3)
  /// { tipo: quantidade } (TIPOS_LIMPEZA).
  apagados    Json      @default("{}")
  /// Contas que já deviam sair mas têm cobrança ativa no Asaas: [{ contaId, conta, motivo }].
  retidas     Json      @default("[]")
  erro        String?

  @@index([iniciadaEm])
  @@map("execucao_limpeza")
}
